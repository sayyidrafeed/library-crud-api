generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Book {
  id          String   @id @default(uuid())
  isbn        String   @unique
  title       String
  author      String
  description String?
  genre       String
  publishedYear Int?
  status      BookStatus @default(AVAILABLE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  loans       Loan[]
}

model Member {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String
  phone       String?
  address     String?
  status      MemberStatus @default(ACTIVE)
  maxLoans    Int      @default(5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  loans       Loan[]
}

model Loan {
  id          String   @id @default(uuid())
  bookId      String
  memberId    String
  borrowedAt  DateTime @default(now())
  dueDate     DateTime
  returnedAt  DateTime?
  renewed     Boolean  @default(false)
  
  book        Book     @relation(fields: [bookId], references: [id])
  member      Member   @relation(fields: [memberId], references: [id])
  
  @@index([bookId])
  @@index([memberId])
}

enum BookStatus {
  AVAILABLE
  BORROWED
  RESERVED
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}
